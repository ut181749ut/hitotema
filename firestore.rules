rules_version = '2';

// ヒトテマ(Firebaseプロジェクト名は旧称の jobchain のまま)用
// Firestore セキュリティルール
//
// このサイトは「求人の掲載と連絡」だけを行う掲示板です。報酬の受け渡しには
// 一切関与しないため、決済に関するフィールド・ルールは存在しません。
//
// 利用者は全員「匿名認証」でサインインしています(メールアドレスも
// パスワードも使いません)。そのため request.auth は必ずFirebaseの匿名
// ユーザーのUIDを指します。
//
// アカウントは1人につき2つまで ——「匿名ゲスト」と、名前を付けて登録した
// 1つだけ。ドキュメントIDを UID と UID_1 に固定することで、3つ目を
// 作れないことをルール側で構造的に保証しています。
//
// 匿名で誰でも投稿できる掲示板なので、通報(reports)とブロック(blocks)を
// 用意しています。通報は運営だけが読め、ブロックは本人だけが読めます。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // accountId のドキュメントが「今リクエストしている本人のアカウント」か。
    function ownsAccount(accountId) {
      return signedIn()
        && accountId != null
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.auth_uid == request.auth.uid;
    }

    // jobId の求人の投稿者(employer_id)が、今リクエストしている本人かどうか。
    function isJobOwner(jobId) {
      return signedIn()
        && ownsAccount(get(/databases/$(database)/documents/jobs/$(jobId)).data.employer_id);
    }

    // ---------------- accounts ----------------
    // 名前・自己紹介などのプロフィール情報。
    // 誰でも読めるが(求人一覧に投稿者名を出すため)、書き込みは本人のみ。
    match /accounts/{accountId} {
      allow read: if signedIn();

      // 作れるのは自分の枠2つだけ。
      //   UID    = 匿名ゲスト
      //   UID_1  = 名前を付けて登録したアカウント
      // これ以外のIDでは作成できないため、1人が3つ以上持つことはできない。
      // (過去に作られたランダムIDのアカウントは、下の update 側で
      //  これまでどおり本人だけが編集できる。)
      allow create: if signedIn()
        && (accountId == request.auth.uid || accountId == request.auth.uid + '_1')
        && request.resource.data.auth_uid == request.auth.uid
        && request.resource.data.is_deleted == false;

      // 自分のアカウントのフィールドは自由に更新できるが、
      // auth_uid(所有者)だけは書き換えられない。
      allow update: if signedIn()
        && resource.data.auth_uid == request.auth.uid
        && request.resource.data.auth_uid == request.auth.uid;

      // アカウントは完全には削除しない(ソフトデリートのみ)。
      // 完全に消すと、他人の求人の「採用者」欄から参照できなくなるため。
      allow delete: if false;
    }

    // ---------------- jobs ----------------
    match /jobs/{jobId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && ownsAccount(request.resource.data.employer_id)
        && request.resource.data.is_open == true
        && request.resource.data.hired_id == null;

      // 更新できるのは投稿者本人のみ(採用の確定・募集の締め切り)。
      allow update: if signedIn()
        && ownsAccount(resource.data.employer_id);

      // 投稿者本人だけが、自分の求人を削除できる
      // (応募・チャットの連動削除はクライアント側で個別に行う)。
      allow delete: if signedIn() && ownsAccount(resource.data.employer_id);
    }

    // ---------------- applications ----------------
    // 「どの求人に誰が応募したか」。誰でも読める(投稿者が応募者一覧を
    // 見られるようにするため)。
    match /applications/{applicationId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && ownsAccount(request.resource.data.applicant_id);

      // 応募の取り下げは応募者本人、または(求人ごと削除するときのために)
      // その求人の投稿者本人のどちらでもできる。
      allow delete: if signedIn() && (
        ownsAccount(resource.data.applicant_id)
        || isJobOwner(resource.data.job_id)
      );

      allow update: if false;
    }

    // ---------------- messages ----------------
    // 求人ごとのチャット。プライバシーのため、自分が送信者(from_id)か
    // 受信者(to_id)のどちらかであるものしか読めない。
    // (クライアント側は from_id / to_id をそれぞれ自分の口座IDの配列で
    //  絞り込んだクエリしか投げない。フィルタしていない全件クエリは
    //  このルールにより拒否される)
    match /messages/{messageId} {
      allow read: if signedIn() && (
        ownsAccount(resource.data.from_id) || ownsAccount(resource.data.to_id)
      );

      allow create: if signedIn()
        && ownsAccount(request.resource.data.from_id);

      // 求人ごと削除するときのために、会話の当事者(投稿者・応募者どちらも)
      // が削除できるようにしておく。
      allow delete: if signedIn() && (
        ownsAccount(resource.data.from_id) || ownsAccount(resource.data.to_id)
      );

      allow update: if false;
    }

    // ---------------- blocks ----------------
    // 「自分が誰をブロックしたか」の記録。自分のものしか読めない。
    // ドキュメントIDを {自分のUID}_{相手のアカウントID} に固定することで、
    // 他人のブロック記録を作ることも消すこともできない。
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blocker_uid == request.auth.uid;

      allow create: if signedIn()
        && blockId == request.auth.uid + '_' + request.resource.data.blocked_id
        && request.resource.data.blocker_uid == request.auth.uid;

      allow delete: if signedIn() && resource.data.blocker_uid == request.auth.uid;

      allow update: if false;
    }

    // ---------------- reports ----------------
    // 通報。運営がFirebaseコンソールで確認するためのもので、
    // 利用者からは一切読めない(誰が誰を通報したかが漏れないようにする)。
    // 送ったあとに取り消し・書き換えもできない。
    match /reports/{reportId} {
      allow read: if false;

      allow create: if signedIn()
        && ownsAccount(request.resource.data.reporter_id)
        && request.resource.data.reporter_uid == request.auth.uid
        && request.resource.data.target_type in ['job', 'account', 'message']
        && request.resource.data.target_id is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000;

      allow update, delete: if false;
    }

    // ---------------- reviews ----------------
    // 採用が決まった求人について、その求人の投稿者⇔採用者という
    // 当事者同士だけが、お互いを星1〜5で評価できる。匿名のままでも
    // 過去の取引実績が見えるようにし、使い捨てアカウントによる
    // 詐欺的な行為を多少なりとも抑止するための仕組み。
    //
    // ドキュメントIDは「{jobId}_{from_id}」という決まった形にしており、
    // これにより「同じ求人について同じ人が2回評価する」ことは
    // (updateを禁止しているため)自然に防げる。
    // 誰が読んでも良い公開情報として扱う(メッセージとは違いプライバシー
    // 対象ではない)。
    match /reviews/{reviewId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && reviewId == (request.resource.data.job_id + '_' + request.resource.data.from_id)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && ownsAccount(request.resource.data.from_id)
        && request.resource.data.from_id != request.resource.data.to_id
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.job_id)).data.hired_id != null
        && (
          (
            get(/databases/$(database)/documents/jobs/$(request.resource.data.job_id)).data.employer_id == request.resource.data.from_id
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.job_id)).data.hired_id == request.resource.data.to_id
          )
          || (
            get(/databases/$(database)/documents/jobs/$(request.resource.data.job_id)).data.hired_id == request.resource.data.from_id
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.job_id)).data.employer_id == request.resource.data.to_id
          )
        );

      // 評価は後から書き換え・取り消しができない(投稿後の報復的な改ざんを防ぐため)。
      allow update, delete: if false;
    }
  }
}
